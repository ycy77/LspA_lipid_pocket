# Copy to local.env. Use absolute paths on your own machine.
# Activate the appropriate external-tool environment before running a stage.
# RFDIFFUSION_DIR=/path/to/RFdiffusion
# LIGANDMPNN_DIR=/path/to/LigandMPNN
# LSP_TARGET_PDB=/path/to/LspA_chain_A.pdb
# LSP_REFERENCE_PDB=/path/to/LspA_chain_A.pdb
# LSP_ADJ_FILE=/path/to/LspA_adj.pt
# LSP_SCAFFOLD_DIR=/path/to/ppi_scaffolds
# LSP_REFINE_TEMPLATE=/path/to/selected_complex.pdb
# LSP_PYTHON=python
# LSP_WORKFLOW_DIR=/path/to/new/results/workflow
# LSP_DATA_DIR=/path/to/new/results/docking
# LSP_ANALYSIS_DIR=/path/to/new/results/analysis
# LSP_WORKERS=4
# LSP_CPUS_PER_TASK=4
# LSP_MAX_CONCURRENT=1

# Stage overrides are best supplied per invocation, for example:
# LSP_INPUT_DIR=/path/to/input LSP_OUTPUT_DIR=/path/to/output bash run.sh ...
