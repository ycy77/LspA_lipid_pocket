MOLINFO STRUCTURE=eq6.pdb
WHOLEMOLECULES ENTITY0=1-2510 ENTITY1=2511-2810 ENTITY2=2811-3211 STRIDE=1
PROA_od: COM ATOMS=1933,2218
PROB_od: COM ATOMS=2803
PORC_od: COM ATOMS=2811
PROA_whole: COM ATOMS=1-2510
PROB_whole: COM ATOMS=2511-2810
PROC_whole: COM ATOMS=2811-3211
local_cv_AC: DISTANCE ATOMS=PROA_od,PORC_od
whole_cv_AB: DISTANCE ATOMS=PROA_whole,PROB_whole
METAD ...
  LABEL=metad
  ARG=whole_cv_AB,local_cv_AC
  SIGMA=0.05,0.05
  HEIGHT=2.5
  PACE=500
  BIASFACTOR=20
  TEMP=300.0
  GRID_MIN=0.0,0.0
  GRID_MAX=5.0,8.0
  GRID_SPACING=0.02,0.02
  FILE=HILLS
... METAD
PRINT ...
  ARG=whole_cv_AB,local_cv_AC,metad.bias
  FILE=COLVAR
  STRIDE=100
  FMT=%8.4f
  LABEL=print_main
... PRINT
