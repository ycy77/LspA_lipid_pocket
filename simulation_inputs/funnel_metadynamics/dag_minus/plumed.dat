MOLINFO STRUCTURE=step5.pdb
WHOLEMOLECULES ENTITY0=1-2510 ENTITY1=2511-3102 STRIDE=1
ligand: COM ATOMS=2511-3102
pro: COM ATOMS=1-2510
cys_peptide_c: COM ATOMS=2812
asp_od: COM ATOMS=1933,2218
anchor_atom: GROUP ATOMS=1933,2218
local_cv: DISTANCE ATOMS=asp_od,cys_peptide_c
whole_cv: DISTANCE ATOMS=ligand,pro
FUNNEL_PS ...
  LABEL=fps
  REFERENCE=step5.gro
  LIGAND=ligand
  ANCHOR=anchor_atom
  POINTS=4.316,4.845,8.113,2.263,6.692,8.243
... FUNNEL_PS
FUNNEL ...
  LABEL=funnel
  ARG=fps.lp,fps.ld
  ZCC=0.5
  ALPHA=0.5
  RCYL=0.3
  MINS=-1.0
  MAXS=4.0
  KAPPA=5000
  NBINS=500
  NBINZ=500
  FILE=FUNNEL
... FUNNEL
LOWER_WALLS ...
  ARG=fps.lp
  AT=-0.3
  KAPPA=2000.0
  EXP=2
... LOWER_WALLS
METAD ...
  LABEL=metad
  ARG=fps.lp,fps.ld
  SIGMA=0.1,0.05
  HEIGHT=3
  PACE=500
  BIASFACTOR=20
  TEMP=310.0
  GRID_MIN=-1.0,0.0
  GRID_MAX=4.0,2.0
  GRID_SPACING=0.05,0.02
  FILE=HILLS
... METAD
PRINT ...
  ARG=fps.lp,fps.ld,local_cv,whole_cv,funnel.bias,metad.bias
  FILE=COLVAR
  STRIDE=500
  FMT=%8.4f
  LABEL=print_main
... PRINT
